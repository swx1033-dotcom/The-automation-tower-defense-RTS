+    private int getConsumerPriority(Building consumer){
+        BlockGroup group = consumer.block.group;
+        if(group == BlockGroup.turrets || group == BlockGroup.projectors || group == BlockGroup.walls) return 0;
+        if(group == BlockGroup.power || group == BlockGroup.logic) return 1;
