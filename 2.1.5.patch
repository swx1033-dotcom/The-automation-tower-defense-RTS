+    private boolean canShed(Building consumer){
+        if(sheddedConsumers.contains(consumer.pos())) return false;
+        if(consumer.block.outputsPower) return false;
+        return true;
+    }
+
+    private void manageLoad(){
+        if(consumers.isEmpty() || Mathf.zero(lastPowerNeeded)) return;
+
+        float satisfaction = getSatisfaction();
+
+        if(satisfaction < shedThreshold){
+            shedConsumers();
+        }else if(satisfaction > recoverThreshold && !sheddedConsumers.isEmpty()){
+            recoverConsumers();
+        }
+    }
+
+    private void shedConsumers(){
+        for(int priority = 3; priority >= 0; priority--){
+            int shedded = 0;
+            for(int i = 0; i < consumers.size && shedded < maxShedPerTick; i++){
+                var consumer = consumers.items[i];
+                if(canShed(consumer) && getConsumerPriority(consumer) == priority){
+                    sheddedConsumers.add(consumer.pos());
+                    consumer.power.status = 0f;
+                    shedded++;
+                }
+            }
+            if(shedded > 0) break;
+        }
+    }
+
+    private void recoverConsumers(){
+        for(int priority = 0; priority <= 3; priority++){
+            int recovered = 0;
+            for(int i = 0; i < consumers.size && recovered < maxRecoverPerTick; i++){
+                var consumer = consumers.items[i];
+                if(sheddedConsumers.contains(consumer.pos()) && getConsumerPriority(consumer) == priority){
+                    sheddedConsumers.remove(consumer.pos());
+                    recovered++;
+                }
+            }
+            if(recovered > 0) break;
+        }
+    }
+
+    public boolean isShedded(Building build){
+        return sheddedConsumers.contains(build.pos());
