+    protected TacticalBulletState tacticalState(Bullet b){
+        TacticalBulletState state = tacticalStates.get(b.id);
+        if(state == null){
+            state = new TacticalBulletState();
+            tacticalStates.put(b.id, state);
+        }
+        return state;
+    }
+
+    protected void clearTacticalState(Bullet b){
+        tacticalStates.remove(b.id);
+    }
+
+    protected boolean validLockUnit(Bullet b, Unit unit, float x, float y, float range, boolean allowUnits){
+        return allowUnits && unit != null && unit.isValid() && unit.checkTarget(collidesAir, collidesGround) && unit.targetable(b.team) && !b.hasCollided(unit.id) && unit.within(x, y, range + unit.hitSize / 2f);
+    }
+
+    protected boolean validLockBuilding(Bullet b, Building build, float x, float y, float range, boolean allowBuildings){
+        return allowBuildings && build != null && collidesGround && !build.dead() && build.team != b.team && !b.hasCollided(build.id) && Mathf.within(x, y, build.x, build.y, range + tilesize / 2f);
+    }
+
+    protected @Nullable Teamc findTacticalTarget(Bullet b, float x, float y, float range, boolean allowUnits, boolean allowBuildings, @Nullable Teamc preferred){
+        if(range <= 0f) return null;
+
+        if(preferred instanceof Unit unit && validLockUnit(b, unit, x, y, range, allowUnits)){
+            return unit;
+        }
+
+        if(preferred instanceof Building build && validLockBuilding(b, build, x, y, range, allowBuildings)){
+            return build;
+        }
+
+        if(allowBuildings && b.aimTile != null && b.aimTile.build != null && validLockBuilding(b, b.aimTile.build, x, y, range, true)){
+            return b.aimTile.build;
+        }
+
+        return Units.closestTarget(b.team, x, y, range,
+            unit -> validLockUnit(b, unit, x, y, range, allowUnits),
+            build -> validLockBuilding(b, build, x, y, range, allowBuildings)
+        );
+    }
+
+    protected boolean bounce(Bullet b, float x, float y){
+        if(bounceCap <= 0) return false;
+
+        TacticalBulletState state = tacticalState(b);
+        if(state.bounces >= bounceCap) return false;
+
+        Teamc target = findTacticalTarget(b, x, y, bounceRange, bounceUnits, bounceBuildings, state.target);
+        if(target == null) return false;
+
+        float angle = Angles.angle(x, y, target.x(), target.y());
+        b.set(x + Angles.trnsx(angle, 0.01f), y + Angles.trnsy(angle, 0.01f));
+        b.vel.setAngle(angle);
+        state.target = target;
+        state.bounces++;
+        return true;
+    }
+
+    protected @Nullable Teamc lockedTarget(Bullet b){
+        if(lockRange <= 0f) return null;
+
+        TacticalBulletState state = tacticalState(b);
+        state.target = findTacticalTarget(b, b.x, b.y, lockRange, lockUnits, lockBuildings, state.target);
+        return state.target;
+    }
+
